{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": ["bun", "react", "react-dom"],
    "skipLibCheck": true
  },
  "include": ["browser/**/*.ts", "react/**/*.ts", "react/**/*.tsx"]
}
