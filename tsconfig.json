{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "ESNext.Disposable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "types": ["bun", "react", "react-dom"],
    "skipLibCheck": true
  },
  "include": ["apps/testy/web/**/*.ts", "apps/testy/web/**/*.tsx", "apps/testy/tests/**/*.ts", "scripts/build-testy.ts"]
}
