{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "snap-chatty",
  "main": "build/index.js",
  "compatibility_date": "2026-09-24",
  "build": { "command": "worker-build --release" },
  "assets": { "directory": "../.snap/web", "binding": "ASSETS", "run_worker_first": true },
  "vars": { "SNAP_ORIGIN": "http://127.0.0.1:8789", "AUTHY_ORIGIN": "http://127.0.0.1:8788", "SNAP_REALM": "chatty" },
  "services": [{ "binding": "AUTHY", "service": "snap-authy" }],
  "durable_objects": { "bindings": [{ "name": "CHATTY", "class_name": "ChattyRealm" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ChattyRealm"] }],
  "observability": { "enabled": true },
  "dev": { "ip": "127.0.0.1", "port": 8789 }
}
