{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "snap-authy",
  "main": "build/index.js",
  "compatibility_date": "2026-09-24",
  "build": { "command": "worker-build --release" },
  "assets": { "directory": "../.snap/build/debug/web", "binding": "ASSETS", "run_worker_first": true },
  "vars": {
    "SNAP_ORIGIN": "http://127.0.0.1:8788",
    "SNAP_REALM": "authy"
  },
  "version_metadata": { "binding": "SNAP_VERSION" },
  "durable_objects": { "bindings": [{ "name": "IDENTITY", "class_name": "IdentityRealm" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["IdentityRealm"] }],
  "observability": { "enabled": true },
  "dev": { "ip": "127.0.0.1", "port": 8788 }
}
