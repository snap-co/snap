{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "snap-workers-contract",
  "main": "build/index.js",
  "compatibility_date": "2026-09-24",
  "build": { "command": "worker-build --release" },
  "vars": { "SNAP_ORIGIN": "http://127.0.0.1:8799" },
  "durable_objects": { "bindings": [{ "name": "STORES", "class_name": "StoreContract" }, { "name": "CARRIERS", "class_name": "CarrierContract" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["StoreContract", "CarrierContract"] }],
  "observability": { "enabled": true }
}
