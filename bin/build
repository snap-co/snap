#!/usr/bin/env bash
# Produces a self-contained native executable + browser assets in dist/.
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
./bin/snap build "$root/apps/healthy" --release "$@"
# Compatibility location. The CLI already produced the complete runnable package.
rm -rf "$root/dist"
cp -a "$root/apps/healthy/.snap/build/release" "$root/dist"
echo "Run ./dist/healthy; it serves the adjacent web/ directory."
