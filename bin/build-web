#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
bun install --frozen-lockfile
./bin/build-client
bun scripts/build-web.ts apps/healthy/web/app.tsx clients/react/main.tsx \
  clients/react/index.html clients/typescript/wasm/snap_client_wasm_bg.wasm dist/web
