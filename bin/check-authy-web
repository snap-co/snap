#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
./bin/snap build --project apps/authy --web-only --output apps/authy/dist/development/web
bunx tsc -p apps/authy/web/tsconfig.json
mise exec -- cargo build -p authy-native
bun scripts/test-authy.ts
