#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
package=snap-browser-tests
case "${1:-all}" in
  testy|authy|chatty|factorio|dev|authy-dev|chatty-dev|dev-origins|factorio-dev)
    package=snap-app-browser-tests
    ;;
esac
if command -v mise >/dev/null; then
  exec mise exec -- cargo run -p "$package" -- --prepare "$@"
fi
exec cargo run -p "$package" -- --prepare "$@"
