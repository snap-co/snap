#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
./bin/snap build --project apps/testy
bunx tsc -p apps/testy/web/tsconfig.json
mise exec -- cargo build -p testy-local -p snap-cli --no-default-features --features testy-local/web --bins
bunx playwright test --config apps/testy/tests/playwright.config.ts
