#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
cargo_cmd=(cargo)
if command -v mise >/dev/null; then cargo_cmd=(mise exec -- cargo); fi
"${cargo_cmd[@]}" fmt --all -- --check
"${cargo_cmd[@]}" clippy --workspace --all-targets -- -D warnings
"${cargo_cmd[@]}" build -p snap-native --examples
"${cargo_cmd[@]}" build -p healthy-native --bins --examples
"${cargo_cmd[@]}" build -p authy-native --bins --examples
./bin/snap check apps/healthy --structure-only --workspace
RUSTDOCFLAGS="-D warnings" "${cargo_cmd[@]}" doc --workspace --no-deps
./bin/check-deps
python3 tests/cli/dev.py
python3 tests/cli/build.py
python3 tests/cli/check.py
python3 tests/cli/architecture.py
"${cargo_cmd[@]}" test -p healthy-native --test client-contract
"${cargo_cmd[@]}" test -p snap-native --test store-contract
"${cargo_cmd[@]}" test -p snap-workers --lib
./bin/build
./bin/snap build apps/authy
bun scripts/check-client.ts
bun test tests/sdk/browser-runtime.test.ts
bun scripts/healthy-smoke.ts
bun test tests/protocol/authy.test.ts
bun test tests/protocol/workers.test.ts
bun test tests/protocol/carriers.test.ts tests/protocol/migration.test.ts tests/protocol/passport-policy.test.ts
bun test tests/sdk/identity-recovery.test.ts
bun scripts/authy-reference.ts
bunx playwright test
python3 scripts/dev-smoke.py
