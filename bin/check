#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
cargo_cmd=(cargo)
if command -v mise >/dev/null; then cargo_cmd=(mise exec -- cargo); fi
packages=(-p snap-execution -p snap-transport -p snap-platform-local -p testy -p testy-local)
"${cargo_cmd[@]}" fmt "${packages[@]}" -- --check
"${cargo_cmd[@]}" clippy "${packages[@]}" --all-targets --features testy-local/native -- -D warnings
"${cargo_cmd[@]}" test "${packages[@]}" --features testy-local/native
"${cargo_cmd[@]}" check -p snap-execution -p snap-transport -p testy --target wasm32v1-none
for features in memory native; do
  tree=$("${cargo_cmd[@]}" tree -p testy-local --no-default-features --features "$features" --edges normal --prefix none)
  while read -r name _; do
    case "$name" in
      snap-execution|snap-transport|snap-platform-local) ;;
      snap-*) echo "Unexpected Testy dependency: $name" >&2; exit 1 ;;
    esac
  done <<< "$tree"
done
