#!/usr/bin/env bash
set -euo pipefail
root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd "$root"
./bin/snap build --project apps/authy --web-only --output apps/authy/dist/development/web
./bin/snap build --project apps/chatty --web-only --output apps/chatty/dist/development/web
bunx tsc -p apps/chatty/web/tsconfig.json
mise exec -- cargo build -p authy-native -p chatty-native
bun scripts/test-chatty.ts
